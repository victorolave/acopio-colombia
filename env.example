# ---------------------------------------------------------------------------
# Acopio Colombia — variables de entorno
#
# Copiar a .env.local:   cp env.example .env.local
#
# La aplicación ARRANCA SIN SUPABASE: si estas variables no están definidas,
# usa el seed nacional estático incluido en data/centers.ts (solo lectura).
# Eso permite desplegar en minutos y conectar la base de datos después.
# ---------------------------------------------------------------------------

# Supabase — proyecto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SOLO servidor. NUNCA con prefijo NEXT_PUBLIC_.
# Se usa para insertar submissions y reportes de la comunidad de forma controlada.
SUPABASE_SERVICE_ROLE_KEY=

# Mapa. OpenFreeMap no exige registro ni API key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# URL pública del sitio (para metadata y OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

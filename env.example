# ---------------------------------------------------------------------------
# Acopio Colombia — variables de entorno
#
# Copiar a .env.local:   cp env.example .env.local
#
# La aplicación ARRANCA SIN SUPABASE: si estas variables no están definidas,
# usa el seed nacional estático incluido en data/centers.ts (solo lectura).
# Eso permite desplegar en minutos y conectar la base de datos después.
# ---------------------------------------------------------------------------

# Supabase — proyecto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SOLO servidor. NUNCA con prefijo NEXT_PUBLIC_.
# Se usa para insertar submissions y reportes de la comunidad de forma controlada.
SUPABASE_SERVICE_ROLE_KEY=

# Mapa. OpenFreeMap no exige registro ni API key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# URL pública del sitio (para metadata y OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de voluntarios para verificación manual.
#
# Es un recurso externo con vida propia: se cierra cuando sobran voluntarios y
# se reabre en la siguiente fase. Por eso vive aquí y no en el código; cambiarlo
# no debería exigir un despliegue.
#
# SIN ESTA VARIABLE la invitación no se muestra en ninguna parte del sitio.
# Es deliberado: mejor sin convocatoria que con un enlace muerto delante de
# alguien que se ofreció a ayudar.
NEXT_PUBLIC_VOLUNTEER_FORM_URL=
